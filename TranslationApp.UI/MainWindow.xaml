<Window x:Class="TranslationApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TranslationApp.UI.Controls"
        xmlns:domain="clr-namespace:TranslationApp.Domain;assembly=TranslationApp.Domain"
        Title="TranslationApp" 
        Height="620" Width="980"
        MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        Icon="Assets/app.ico">

    <!-- هيكل WindowChrome لنظام ويندوز 11 لدعم حركة DWM الأصلية و Snap Layouts وخامة Mica الزجاجية -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      ResizeBorderThickness="6"
                      CaptionHeight="42"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- شبكة الهيكل الجذرية: ترث لون خلفية نظام ويندوز الحي ديناميكياً مع ضبط حواف التكبير -->
    <Grid x:Name="RootGrid" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <!-- عند تكبير النافذة (Maximized)، سحب المحتوى 7 بكسل داخل الشاشة لمنع قطع الحواف على شاشات ويندوز -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Normal">
                        <Setter Property="Margin" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <!-- 1. شبكة المحتوى الأساسية (Main Layout Grid) -->
        <Grid x:Name="MainContentGrid">
            <Grid.RowDefinitions>
                <!-- الصف 0: الشريط العلوي (TitleBar) -->
                <RowDefinition Height="42"/>
                <!-- الصف 1: شريط اختيار وتبديل اللغات العائم -->
                <RowDefinition Height="50"/>
                <!-- الصف 2: مساحة العمل الرئيسية (كرت الإدخال + كرت النتيجة) -->
                <RowDefinition Height="*"/>
                <!-- الصف 3: حافة الهامش السفلي -->
                <RowDefinition Height="14"/>
            </Grid.RowDefinitions>

            <!-- [الصف 0]: هيكل الشريط العلوي (TitleBar) -->
            <Grid Grid.Row="0" x:Name="TitleBarGrid" Margin="0" FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <!-- عمود العنوان والأيقونات اليسرى -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- مساحة السحب والتحريك (Draggable Window Area) -->
                    <ColumnDefinition Width="*"/>
                    <!-- عمود أزرار التحكم والإعدادات -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- أيقونة وعنوان التطبيق بلون التمييز الحي لويندوز -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="Assets/app.png" Width="24" Height="24" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="AppTitleTextBlock" Text="TranslationApp" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontFamily="Segoe UI Variable, Segoe UI"/>
                </StackPanel>

                <!-- الجانب الأيمن: أزرار التثبيت والإعدادات وأزرار نافذة Windows 11 الأصلية الملاصقة للحافة -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0">
                    <!-- أزرار الإجراءات السريعة (تثبيت، إعدادات) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,10,0">
                        <!-- زر تثبيت النافذة فوق النوافذ -->
                        <controls:FluentButtonBase x:Name="PinButton" Icon="&#xE718;" ToolTip="تثبيت في المقدمة" Width="36" Height="32" Margin="0,0,4,0" WindowChrome.IsHitTestVisibleInChrome="True" Click="PinButton_Click"/>
                        <!-- زر الإعدادات الرئيسي (الأب الروحي لكافة الخدمات) -->
                        <controls:FluentButtonBase x:Name="SettingsButton" Icon="&#xE713;" ToolTip="الإعدادات والتفضيلات" Width="36" Height="32" WindowChrome.IsHitTestVisibleInChrome="True" Click="SettingsButton_Click"/>
                    </StackPanel>

                    <!-- أزرار نافذة Windows 11 الأصلية (تصغير، تكبير، إغلاق) ملاصقة للزاوية بدقة 46x40 -->
                    <StackPanel Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" Style="{StaticResource WindowCaptionButtonStyle}" Content="&#xE921;" ToolTip="تصغير" Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowCaptionButtonStyle}" Content="&#xE922;" ToolTip="تكبير" Click="MaximizeButton_Click"/>
                        <Button x:Name="CloseButton" Style="{StaticResource WindowCaptionCloseButtonStyle}" Content="&#xE8BB;" ToolTip="إغلاق" Click="CloseButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- [الصف 1]: شريط اللغات الموحد بتصميم الكبسولة العائمة (Fluent Floating Capsule) -->
            <Grid Grid.Row="1" x:Name="LanguageBarGrid" Margin="24,0,24,0">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Background="{DynamicResource CardBackgroundBrush}" 
                        BorderBrush="{DynamicResource CardBorderBrush}" 
                        BorderThickness="1" CornerRadius="12" Padding="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- لغة المصدر -->
                        <Border x:Name="SourceLanguageCapsule" MinWidth="130" Height="34" CornerRadius="8" Background="Transparent" Padding="14,0" Cursor="Hand" MouseLeftButtonDown="SourceLanguageCapsule_MouseDown" MouseLeftButtonUp="SourceLanguageCapsule_MouseUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="SourceLanguageLabel" Text="العربية" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI Variable, Segoe UI"/>
                                <TextBlock Text="&#xE96E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" Margin="8,2,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- زر التبديل الدائري الأنيق مع تأثير Hover وحركة Scale -->
                        <controls:FluentButtonBase x:Name="SwapLanguagesButton" Icon="&#xE8AB;" ActionFlag="SwapLanguages" ToolTip="تبديل اللغات" Width="34" Height="34" CornerRadius="17" Margin="6,0" Click="SwapLanguagesButton_Click"/>

                        <!-- لغة الهدف -->
                        <Border x:Name="TargetLanguageCapsule" MinWidth="130" Height="34" CornerRadius="8" Background="Transparent" Padding="14,0" Cursor="Hand" MouseLeftButtonDown="TargetLanguageCapsule_MouseDown" MouseLeftButtonUp="TargetLanguageCapsule_MouseUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="TargetLanguageLabel" Text="English" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI Variable, Segoe UI"/>
                                <TextBlock Text="&#xE96E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" Margin="8,2,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- نافذة اختيار اللغات المنبثقة الأصلية (Fluent Dropdown Popup) -->
                <Popup x:Name="LanguageDropdownPopup"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       Placement="Bottom"
                       VerticalOffset="-4">
                    <Grid Margin="8">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="4"
                                MinWidth="190">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.30" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel x:Name="LanguageDropdownItemsHost" />
                        </Border>
                    </Grid>
                </Popup>
            </Grid>

            <!-- [الصف 2]: مساحة العمل المزدوجة الزجاجية (Frosted Dual Workspace) -->
            <Grid Grid.Row="2" x:Name="WorkspaceGrid" Margin="24,6,24,0">
                <Grid.ColumnDefinitions>
                    <!-- العمود 0: كرت الإدخال الأيسر -->
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <!-- العمود 1: مسافة بين الكرتين -->
                    <ColumnDefinition Width="16"/>
                    <!-- العمود 2: كرت النتيجة الأيمن -->
                    <ColumnDefinition Width="*" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <!-- 1. كرت الإدخال (Source Card) -->
                <Border Grid.Column="0" x:Name="SourceCardBorder" CornerRadius="14" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Opacity="0.12" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- مساحة كتابة النص -->
                            <RowDefinition Height="*"/>
                            <!-- خط فاصل ناعم -->
                            <RowDefinition Height="1"/>
                            <!-- شريط الأزرار السفلي للمصدر -->
                            <RowDefinition Height="46"/>
                        </Grid.RowDefinitions>

                        <!-- حقل إدخال النص مع خط واضح وتمرير سلس ودعم كامل لاتجاه RTL وتقييد 5000 حرف -->
                        <TextBox Grid.Row="0" x:Name="SourceTextBox" 
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MaxLength="5000"
                                 FlowDirection="RightToLeft"
                                 TextAlignment="Left"
                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource SystemAccentBrush}" FontSize="15"
                                 FontFamily="Segoe UI Variable, Segoe UI"
                                 BorderThickness="0" Margin="16,14,16,10"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="SourceTextBox_TextChanged"/>

                        <!-- خط فاصل ناعم شفاف -->
                        <Border Grid.Row="1" Background="{DynamicResource DividerLineBrush}" Margin="12,0"/>

                        <!-- أزرار الإجراءات السفلية لكرت الإدخال -->
                        <Grid Grid.Row="2" Margin="14,0,14,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <!-- زر النطق الصوتي للمصدر (معطل مؤقتاً) -->
                                <controls:FluentButtonBase x:Name="SourceSpeakButton" Icon="&#xE768;" ActionFlag="SpeakSource" ToolTip="استماع للنص" Width="34" Height="34" Margin="0,0,6,0" Visibility="Collapsed" Click="SourceSpeakButton_Click"/>
                                <!-- زر مسح النص -->
                                <controls:FluentButtonBase x:Name="SourceClearButton" Icon="&#xE74D;" ActionFlag="ClearSource" ToolTip="مسح الحقل" Width="34" Height="34" Click="SourceClearButton_Click"/>
                            </StackPanel>

                            <!-- عداد الحروف والكلمات -->
                            <TextBlock x:Name="SourceCounterTextBlock" Text="0 / 5000" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                       FontFamily="Segoe UI Variable, Segoe UI"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 2. كرت النتيجة (Target Card) -->
                <Border Grid.Column="2" x:Name="TargetCardBorder" CornerRadius="14" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Opacity="0.12" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- مساحة عرض الترجمة -->
                            <RowDefinition Height="*"/>
                            <!-- خط فاصل ناعم -->
                            <RowDefinition Height="1"/>
                            <!-- شريط الأزرار السفلي للنتيجة -->
                            <RowDefinition Height="46"/>
                        </Grid.RowDefinitions>

                        <!-- حقل عرض الترجمة (للقراءة فقط مع اتجاه النص المناسب) -->
                        <TextBox Grid.Row="0" x:Name="TargetTextBox" 
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 FlowDirection="LeftToRight"
                                 TextAlignment="Left"
                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontFamily="Segoe UI Variable, Segoe UI"
                                 FontSize="15" BorderThickness="0" Margin="16,14,16,10"
                                 VerticalScrollBarVisibility="Auto"/>

                        <!-- شريط تقدم الترجمة الفورية الناعم -->
                        <ProgressBar Grid.Row="0" x:Name="TranslationProgressBar" Height="2" IsIndeterminate="True"
                                     Foreground="{DynamicResource SystemAccentBrush}" Background="Transparent"
                                     BorderThickness="0" VerticalAlignment="Top" Margin="14,0,14,0" Visibility="Collapsed"/>

                        <!-- لوحة عرض الخطأ التفاعلية والواضحة (Fluent Error Panel) -->
                        <Border Grid.Row="0" x:Name="TranslationErrorPanel" Visibility="Collapsed"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="12"
                                Margin="16,14,16,10" Padding="16"
                                VerticalAlignment="Center" HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="42" Height="42" CornerRadius="21" Background="#22E81123" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock x:Name="ErrorIconTextBlock" Text="&#xE783;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Foreground="#E81123" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="ErrorTitleTextBlock" Text="تعذر الاتصال بخوادم الترجمة"
                                           FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" FontFamily="Segoe UI Variable, Segoe UI"/>
                                <TextBlock x:Name="ErrorMessageTextBlock" Text="يرجى التحقق من اتصال الإنترنت وإعادة المحاولة."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,14"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" FontFamily="Segoe UI Variable, Segoe UI"/>
                                <controls:FluentButtonBase x:Name="RetryTranslationButton" Content="إعادة المحاولة" Height="32" Padding="16,0"
                                                           HorizontalAlignment="Center" Click="RetryTranslationButton_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- خط فاصل ناعم شفاف -->
                        <Border Grid.Row="1" Background="{DynamicResource DividerLineBrush}" Margin="12,0"/>

                        <!-- أزرار الإجراءات السفلية لكرت النتيجة -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,14,0">
                            <!-- زر النسخ التفاعلي الموروث -->
                            <controls:FluentButtonBase x:Name="CopyButton" Icon="&#xE8C8;" ActionFlag="CopyTarget" Content="نسخ" ToolTip="نسخ الترجمة" Height="34" MinWidth="75" Margin="0,0,8,0" Click="CopyButton_Click"/>
                            <!-- زر النطق الصوتي للترجمة (معطل مؤقتاً) -->
                            <controls:FluentButtonBase x:Name="TargetSpeakButton" Icon="&#xE768;" ActionFlag="SpeakTarget" ToolTip="استماع للترجمة" Width="34" Height="34" Margin="0,0,6,0" Visibility="Collapsed" Click="TargetSpeakButton_Click"/>
                            <!-- زر المفضلة (معطل ومخفي مؤقتاً لتطابق إخفاء قسم المفضلة في الإعدادات) -->
                            <controls:FluentButtonBase x:Name="FavoriteButton" Icon="&#xE734;" ActionFlag="Favorite" ToolTip="إضافة للمفضلة" Width="34" Height="34" Visibility="Collapsed" Click="FavoriteButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 2. طبقة درج الإعدادات المنبثق الزجاجي الفاخر (Settings Overlay & Frosted Flyout) -->
        <Grid x:Name="SettingsOverlayLayer" Visibility="Collapsed" Panel.ZIndex="100">
            <!-- خلفية التعتيم الشفافة (Scrim): عند النقر عليها يغلق درج الإعدادات فوراً -->
            <Border x:Name="SettingsScrim" Background="{DynamicResource SettingsOverlayScrimBrush}" MouseDown="SettingsScrim_MouseDown"/>

            <!-- درج الإعدادات المنبثق الزجاجي المصقول الفاخر (Floating Frosted Drawer) -->
            <Border x:Name="SettingsFlyoutContainer" 
                    Width="380" HorizontalAlignment="Right"
                    Background="{DynamicResource SettingsFlyoutBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1,0,0,0"
                    CornerRadius="16,0,0,16"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" Direction="180" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
                </Border.Effect>
                <Grid Margin="18,14,18,16">
                    <Grid.RowDefinitions>
                        <!-- ترويسة الإعدادات -->
                        <RowDefinition Height="46"/>
                        <!-- جسم الإعدادات وقائمة الكروت -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ترويسة الدرج: العنوان وأيقونة الإعدادات وزر الإغلاق -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource SystemAccentBrush}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SettingsHeaderTitle" Text="الإعدادات والتفضيلات" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" FontFamily="Segoe UI Variable, Segoe UI"/>
                        </StackPanel>
                        <controls:FluentButtonBase x:Name="CloseSettingsDrawerButton" Icon="&#xE8BB;" ToolTip="إغلاق الإعدادات" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseSettingsDrawerButton_Click"/>
                    </Grid>

                    <!-- قائمة كروت الإعدادات (Scrollable) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel x:Name="SettingsCardsStackPanel">

                            <!-- كرت 1: المظهر — Appearance -->
                            <Border x:Name="AppearanceCard" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource ControlBackgroundBrush}" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource SystemAccentBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="AppearanceCardTitle" Text="المظهر والثيم" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI Variable, Segoe UI"/>
                                            <TextBlock x:Name="AppearanceCardSubtitle" Text="التكيف مع مظهر ويندوز" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontFamily="Segoe UI Variable, Segoe UI" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <UniformGrid Columns="3" Margin="0,4,0,0">
                                        <controls:FluentButtonBase x:Name="ThemeSystemButton" Icon="&#xE790;" Content="النظام" Height="32" Margin="0,0,3,0" FontSize="11" Click="ThemeSystemButton_Click"/>
                                        <controls:FluentButtonBase x:Name="ThemeLightButton" Icon="&#xE706;" Content="فاتح" Height="32" Margin="2,0,2,0" FontSize="11" Click="ThemeLightButton_Click"/>
                                        <controls:FluentButtonBase x:Name="ThemeDarkButton" Icon="&#xE708;" Content="داكن" Height="32" Margin="3,0,0,0" FontSize="11" Click="ThemeDarkButton_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- كرت 2: لغة التطبيق — App Language -->
                            <Border x:Name="AppLanguageCard" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource ControlBackgroundBrush}" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource SystemAccentBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="AppLanguageCardTitle" Text="لغة التطبيق" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI Variable, Segoe UI"/>
                                            <TextBlock x:Name="AppLanguageCardSubtitle" Text="لغة عرض واجهة التطبيق" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontFamily="Segoe UI Variable, Segoe UI" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <UniformGrid Columns="3" Margin="0,4,0,0">
                                        <controls:FluentButtonBase x:Name="LangSystemButton" Icon="&#xE774;" Content="النظام" Height="32" Margin="0,0,3,0" FontSize="11" Click="LangSystemButton_Click"/>
                                        <controls:FluentButtonBase x:Name="LangArabicButton" Content="العربية" Height="32" Margin="2,0,2,0" FontSize="11" Click="LangArabicButton_Click"/>
                                        <controls:FluentButtonBase x:Name="LangEnglishButton" Content="English" Height="32" Margin="3,0,0,0" FontSize="11" Click="LangEnglishButton_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- كرت 3: سلوك النافذة — Window Behavior -->
                            <Border x:Name="WindowBehaviorCard" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource ControlBackgroundBrush}" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource SystemAccentBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="WindowBehaviorCardTitle" Text="سلوك النافذة" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI Variable, Segoe UI"/>
                                            <TextBlock x:Name="WindowBehaviorCardSubtitle" Text="خيارات التثبيت والأتمتة" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontFamily="Segoe UI Variable, Segoe UI" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- الخيار 1: إبقاء النافذة في المقدمة دائماً -->
                                    <Grid Margin="0,4,0,6">
                                        <TextBlock x:Name="AlwaysOnTopLabel" Text="إبقاء النافذة في المقدمة دائماً" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontFamily="Segoe UI Variable, Segoe UI" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="AlwaysOnTopCheckBox" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" Click="AlwaysOnTopCheckBox_Click"/>
                                    </Grid>
                                    <!-- الخيار 2: نسخ الترجمة تلقائياً إلى الحافظة -->
                                    <Grid Margin="0,6,0,0">
                                        <TextBlock x:Name="AutoCopyLabel" Text="نسخ الترجمة تلقائياً إلى الحافظة" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontFamily="Segoe UI Variable, Segoe UI" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="AutoCopyCheckBox" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" Click="AutoCopyCheckBox_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- البطاقات المؤجلة (مخفية مؤقتاً للحفاظ على بساطة الإعدادات مع صون المكونات للاستخدام المستقبلي) -->
                            <StackPanel x:Name="DeferredSettingsCards" Visibility="Collapsed">
                                <!-- كرت المساعد الذكي لمؤشر الفأرة -->
                                <Border x:Name="CursorAssistantCard" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource SystemAccentBrush}" Margin="0,0,10,0">
                                                <TextBlock Text="&#xE8BD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="المساعد الذكي لمؤشر الفأرة" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI Variable, Segoe UI"/>
                                                <TextBlock Text="نافذة سريعة عند التحديد أو الاختصار" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontFamily="Segoe UI Variable, Segoe UI" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" x:Name="AssistantEnabledCheckBox" IsChecked="False" VerticalAlignment="Center" Cursor="Hand" Click="AssistantEnabledCheckBox_Click"/>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource DividerLineBrush}" Margin="0,0,0,12"/>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="اختصار الترجمة السريعة:" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" FontSize="12" FontFamily="Segoe UI Variable, Segoe UI"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border x:Name="HotKeyDisplayBadge" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                                    <TextBlock x:Name="HotKeyDisplayTextBlock" Text="Ctrl + Shift + C" Foreground="{DynamicResource SystemAccentBrush}" FontWeight="SemiBold" FontSize="12" FontFamily="Segoe UI Variable, Segoe UI"/>
                                                </Border>
                                                <controls:FluentButtonBase x:Name="ChangeHotKeyButton" Content="تغيير" Width="52" Height="30" FontSize="11" Click="ChangeHotKeyButton_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <RadioButton x:Name="PillModeRadioButton" Grid.Column="0" Content="كبسولة لطيفة (Pill)" Foreground="{DynamicResource TextPrimaryBrush}" IsChecked="True" FontSize="11" FontFamily="Segoe UI Variable, Segoe UI" Click="AssistantMode_Changed"/>
                                            <RadioButton x:Name="InstantCardRadioButton" Grid.Column="1" Content="بطاقة فورية (Card)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontFamily="Segoe UI Variable, Segoe UI" Click="AssistantMode_Changed"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- كرت إدارة وتوسيع اللغات -->
                                <Border x:Name="LanguageBitmaskCard" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="إدارة اللغات" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI Variable, Segoe UI"/>
                                        <RadioButton x:Name="UiLangArabicRadio" Content="العربية" Foreground="{DynamicResource TextPrimaryBrush}" IsChecked="True" FontSize="11" FontFamily="Segoe UI Variable, Segoe UI" Margin="0,4,0,0"/>
                                        <RadioButton x:Name="UiLangEnglishRadio" Content="English" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontFamily="Segoe UI Variable, Segoe UI" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- كرت المفضلة والترجمات المحفوظة -->
                                <Border x:Name="FavoritesCard" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="FavoritesCountTextBlock" Text="0 عناصر محفوظة" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontFamily="Segoe UI Variable, Segoe UI"/>
                                            <controls:FluentButtonBase Grid.Column="1" x:Name="ClearFavoritesButton" Icon="&#xE74D;" ToolTip="مسح المفضلة" Width="30" Height="30" Click="ClearFavoritesButton_Click"/>
                                        </Grid>
                                        <ItemsControl x:Name="FavoritesItemsControl"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- كرت 4: حول التطبيق ومعلومات المطور (قابل للطي والتوسيع بسلاسة) -->
                            <Border x:Name="AboutAppCard" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- شريط رأس كرت حول التطبيق (قابل للنقر لتوسيع أو طي التفاصيل) -->
                                    <Grid x:Name="AboutAppHeaderGrid" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="AboutAppHeader_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- أيقونة حول التطبيق -->
                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource ControlBackgroundBrush}" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource SystemAccentBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- عنوان ووصف الكرت -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="AboutAppTitleTextBlock" Text="حول التطبيق" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI Variable, Segoe UI"/>
                                            <TextBlock x:Name="AboutAppSubtitleTextBlock" Text="معلومات الإصدار والمطور" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontFamily="Segoe UI Variable, Segoe UI" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- زر السهم للتوسيع والطي (Chevron) -->
                                        <Border Grid.Column="2" Width="28" Height="28" CornerRadius="6" Background="{DynamicResource ControlBackgroundBrush}" VerticalAlignment="Center">
                                            <TextBlock x:Name="AboutAppChevronTextBlock" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- لوحة تفاصيل حول التطبيق (مخفية افتراضياً وتظهر عند النقر) -->
                                    <StackPanel x:Name="AboutAppDetailsPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                        <Border Height="1" Background="{DynamicResource DividerLineBrush}" Margin="0,0,0,12"/>

                                        <!-- السطر 1: أيقونة التطبيق، الاسم، الموديل والإصدار -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Column="0" Source="Assets/app.png" Width="26" Height="26" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="TranslationApp" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13" FontFamily="Segoe UI Variable, Segoe UI"/>
                                                <TextBlock x:Name="DeveloperAppModelTextBlock" Text="دوت نت 9" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontFamily="Segoe UI Variable, Segoe UI"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Text="1.0.0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI Variable, Segoe UI"/>
                                            </Border>
                                        </Grid>

                                        <!-- السطر 2: معلومات المطور والبريد التفاعلي -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource ControlBackgroundBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource SystemAccentBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="DeveloperNameTextBlock" Text="المطور: muath" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12.5" FontFamily="Segoe UI Variable, Segoe UI"/>
                                                <!-- زر إرسال البريد التفاعلي: يفتح تطبيق البريد مباشرة في نظام التشغيل -->
                                                <Button x:Name="DeveloperEmailButton" Click="DeveloperEmailButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0" HorizontalAlignment="Left" Margin="0,2,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="&#xE715;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource SystemAccentBrush}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="mmuath2025@gmail.com" Foreground="{DynamicResource SystemAccentBrush}" TextDecorations="Underline" FontSize="11" FontFamily="Segoe UI Variable, Segoe UI" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- السطر 3: مكان الصنع (نفس إخوانه تكست) -->
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource ControlBackgroundBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE707;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource SystemAccentBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="MadeInRiyadhTextBlock" Text="مكان الصنع: المملكة العربية السعودية، الرياض 🇸🇦" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontFamily="Segoe UI Variable, Segoe UI" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>

                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
